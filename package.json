{
	"name": "coucool-cms",
	"private": true,
	"version": "1.0.0",
	"main": "package.json",
	"license": "UNLICENSED",
	"scripts": {
		"dev": "sanity dev",
		"start": "sanity start",
		"build": "sanity build",
		"deploy": "sanity deploy",
		"deploy-graphql": "sanity graphql deploy",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"check-lint": "eslint . --max-warnings=0",
		"check-types": "tsc --noEmit",
		"lint": "tsc --noEmit && eslint . --max-warnings=0",
		"prepare": "husky",
		"clone-to-production": "sanity dataset export staging staging.tar.gz && sanity dataset import staging.tar.gz production --replace && rm -rf staging.tar.gz",
		"clone-to-staging": "sanity dataset export production production.tar.gz && sanity dataset import production.tar.gz staging --replace && rm -rf production.tar.gz"
	},
	"dependencies": {
		"@sanity/asset-utils": "^2.3.0",
		"@sanity/cli": "^5.9.0",
		"@sanity/color-input": "^6.0.4",
		"@sanity/icons": "^3.7.4",
		"@sanity/image-url": "^2.0.3",
		"@sanity/orderable-document-list": "^1.5.0",
		"@sanity/ui": "^3.1.11",
		"@sanity/vision": "^5.9.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"rxjs": "^7.8.2",
		"sanity": "^5.9.0",
		"styled-components": "^6.3.9"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@sanity/types": "^5.9.0",
		"@types/node": "^25.2.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.1.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-unicorn": "^62.0.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"prettier": "^3.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.18.0"
	}
}
